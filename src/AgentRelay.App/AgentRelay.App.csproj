<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentRelay.Core\AgentRelay.Core.csproj" />
    <ProjectReference Include="..\AgentRelay.Windows\AgentRelay.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AgentRelay</AssemblyName>
    <RootNamespace>AgentRelay.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AgentRelay.ico</ApplicationIcon>
    <Version>0.5.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AgentRelay.ico" />
    <Content Include="Assets\external-agent-delegation\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
