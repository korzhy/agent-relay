<Application x:Class="AgentRelay.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151A23"/>
        <SolidColorBrush x:Key="CardBrush" Color="#202735"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6BE3C2"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D3748"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EDF5"/>
        </Style>
    </Application.Resources>
</Application>
