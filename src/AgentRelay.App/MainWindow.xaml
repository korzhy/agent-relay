<Window x:Class="AgentRelay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Relay" Height="720" Width="1040" MinHeight="650" MinWidth="900"
        Background="{StaticResource SurfaceBrush}" Foreground="#E8EDF5"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AGENT RELAY" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Sol управляет передачей проверяемой работы внешнему Gemini executor"
                           Foreground="#AAB7CA" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="QuotaChip" Style="{StaticResource HeaderChipStyle}"
                        ToolTipService.ShowDuration="30000">
                    <TextBlock x:Name="QuotaText" Text="Квота: проверка…"/>
                </Border>
                <Button x:Name="HealthButton" Content="Relay: проверка…"
                        Style="{StaticResource HeaderButtonStyle}" Click="Health_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="14"
                Padding="20" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Порог внешнего делегирования" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ThresholdDescription"
                               Text="Определяет, насколько охотно Sol отдаёт подходящую работу Gemini executor."
                               Foreground="#9EABBE" Margin="0,4,0,0"/>
                </StackPanel>
                <UniformGrid Grid.Column="1" Rows="1" Columns="4" Margin="20,0,0,0">
                    <RadioButton x:Name="ThresholdOff" Content="OFF" Tag="Off" GroupName="Threshold"
                                 Style="{StaticResource ThresholdButtonStyle}" Checked="Threshold_Checked"/>
                    <RadioButton x:Name="ThresholdLow" Content="LOW" Tag="Low" GroupName="Threshold"
                                 Style="{StaticResource ThresholdButtonStyle}" Checked="Threshold_Checked"/>
                    <RadioButton x:Name="ThresholdMedium" Content="MEDIUM" Tag="Medium" GroupName="Threshold"
                                 Style="{StaticResource ThresholdButtonStyle}" Checked="Threshold_Checked"/>
                    <RadioButton x:Name="ThresholdHigh" Content="HIGH" Tag="High" GroupName="Threshold"
                                 Style="{StaticResource ThresholdButtonStyle}" Checked="Threshold_Checked"/>
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="MissionTitleText" Text="Нет активной делегации"
                                   FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MissionMetaText" Text="Sol использует Gemini executor только когда порог и задача это оправдывают."
                                   Foreground="#91A0B5" Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Antigravity / latest observed Gemini High"
                               Foreground="#8EA0BA" VerticalAlignment="Top" Margin="18,4,0,0"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#182334" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse x:Name="SolDot" Width="11" Height="11" Fill="#718096"
                                         Margin="0,3,9,0" VerticalAlignment="Top"/>
                                <TextBlock Text="SOL · ORCHESTRATOR" FontSize="12" FontWeight="Bold"
                                           Foreground="#8DB7FF"/>
                            </DockPanel>
                            <TextBlock x:Name="SolStatusText" Text="Статус не подтверждён"
                                       FontSize="23" FontWeight="SemiBold" Margin="0,14,0,6"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SolDetailText"
                                       Text="Нет явной операционной фазы от текущей задачи Codex."
                                       Foreground="#B4C0D1" TextWrapping="Wrap" MinHeight="44"/>
                            <TextBlock x:Name="SolAgeText" Text="" Foreground="#718096"
                                       FontSize="11" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="→" FontSize="38" Foreground="#586A82" HorizontalAlignment="Center"/>
                        <TextBlock Text="HAND-OFF" FontSize="10" FontWeight="Bold"
                                   Foreground="#718096" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#182B29" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse x:Name="FlashDot" Width="11" Height="11" Fill="#718096"
                                         Margin="0,3,9,0" VerticalAlignment="Top"/>
                                <TextBlock Text="GEMINI · EXECUTOR" FontSize="12" FontWeight="Bold"
                                           Foreground="#6BE3C2"/>
                            </DockPanel>
                            <TextBlock x:Name="FlashStatusText" Text="Не задействован"
                                       FontSize="23" FontWeight="SemiBold" Margin="0,14,0,6"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="FlashDetailText"
                                       Text="Нет активного внешнего runner."
                                       Foreground="#B4C0D1" TextWrapping="Wrap" MinHeight="44"/>
                            <TextBlock x:Name="FlashAgeText" Text="" Foreground="#718096"
                                       FontSize="11" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Grid.Row="2" Rows="1" Columns="5" Margin="0,0,0,16">
                    <TextBlock x:Name="DecisionStep" Text="1  Решение Sol" Style="{StaticResource MissionStepStyle}"/>
                    <TextBlock x:Name="FlashStep" Text="2  Работа Gemini" Style="{StaticResource MissionStepStyle}"/>
                    <TextBlock x:Name="ReportStep" Text="3  Отчёт" Style="{StaticResource MissionStepStyle}"/>
                    <TextBlock x:Name="ReviewStep" Text="4  Проверка Sol" Style="{StaticResource MissionStepStyle}"/>
                    <TextBlock x:Name="IntegrateStep" Text="5  Интеграция" Style="{StaticResource MissionStepStyle}"/>
                </UniformGrid>

                <Grid Grid.Row="3">
                    <TextBlock x:Name="LastActionText" Text="Без hidden reasoning · только подтверждённые действия"
                               Foreground="#8291A7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="ContextPanel" Background="#2B2530" CornerRadius="8" Padding="12"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="ContextActionButton" DockPanel.Dock="Right"
                                    Content="Подробнее" Click="ContextAction_Click"
                                    Margin="16,0,0,0"/>
                            <TextBlock x:Name="ContextText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="#91A0B5" Text="Готово."/>
            <TextBlock x:Name="UpdateFooterText" HorizontalAlignment="Right" Foreground="#627086"
                       Text="Автообновление включено · autostart выключен"/>
        </Grid>
    </Grid>
</Window>
