<Window x:Class="AgentRelay.App.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Relay — Аккаунты" Height="560" Width="920" MinHeight="480" MinWidth="760"
        Background="{StaticResource SurfaceBrush}" Foreground="#E8EDF5"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Managed PRO / ULTRA аккаунты" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="OAuth выполняет штатный agy. Antigravity Tools и его Free-аккаунты не читаются и не изменяются."
                       Foreground="#9EABBE" Margin="0,5,0,16"/>
        </StackPanel>
        <DataGrid x:Name="AccountsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Background="#182334" Foreground="#E8EDF5"
                  RowBackground="#182334" AlternatingRowBackground="#1E2A3C" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Метка" Binding="{Binding Label}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="90"/>
                <DataGridTextColumn Header="Квота" Binding="{Binding Quota}" Width="90"/>
                <DataGridTextColumn Header="Проверено" Binding="{Binding Checked}" Width="140"/>
                <DataGridTextColumn Header="Диагностика" Binding="{Binding Diagnostic}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Метка нового аккаунта:" VerticalAlignment="Center"/>
            <TextBox x:Name="LabelText" Grid.Column="1" Margin="8,0,20,0" Padding="7"/>
            <TextBlock Grid.Column="2" Text="Порог ротации, %:" VerticalAlignment="Center"/>
            <TextBox x:Name="ThresholdText" Grid.Column="3" Margin="8,0,0,0" Padding="7"/>
        </Grid>
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="StatusText" Foreground="#91A0B5" VerticalAlignment="Center"
                       Text="Готово." TextTrimming="CharacterEllipsis"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Добавить OAuth" Click="Add_Click" Margin="6,0" Padding="12,7"/>
                <Button Content="Активировать" Click="Activate_Click" Margin="6,0" Padding="12,7"/>
                <Button Content="Обновить" Click="Refresh_Click" Margin="6,0" Padding="12,7"/>
                <Button Content="Удалить" Click="Remove_Click" Margin="6,0" Padding="12,7"/>
                <Button Content="Сохранить порог" Click="Settings_Click" Margin="6,0" Padding="12,7"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
